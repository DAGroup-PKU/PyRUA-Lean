{
  "schema": "datafarm.task-cost-policy/2",
  "target_usd": 30,
  "limit_usd": 50,
  "scope": "all-model-work-through-white-data",
  "includes": [
    "orchestration",
    "implementation",
    "expert",
    "review",
    "retries",
    "repair"
