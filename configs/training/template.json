{
  "schema_version": "datafarm.pi05-finetune/1.1.0",
  "experiment_intent": "Describe what this run trains and what it is compared with.",
  "target_task": "<task>",
  "required_distribution_claim": "local_robustness",
  "training_scope": "exploratory_diagnostic",
  "terminal_home_contract": {
    "schema_version": "eef_terminal_home_contract/1.1.0",
    "canonical_home_state_14d": "<14 numbers: home state of your robot as left x y z roll pitch yaw gripper, right x y z roll pitch yaw gripper>",
    "max_translation_error_m": 0.005,
    "max_rotation_error_rad": 0.035,
    "max_gripper_error_m": 0.002,
    "stationary_tail_frames": 10,
    "require_source_joint_home_and_collision_sweep": true,
    "max_stationary_tail_translation_m": 0.002,
    "max_stationary_tail_rotation_rad": 0.005,
    "max_stationary_tail_gripper_m": 0.0005
  },
  "distribution_acceptance": {
    "path": "${WORKSPACE}/runs/<task>/distribution-acceptance.json",
    "sha256": null
  },
  "trainer_root": "${TRAINER}",
  "trainer_python": "${TRAINING_PYTHON}",
  "trainer_source_sha256": {
    "scripts/train.py": "3bb060113f47ddd30c27a7cd5a37c1378b402338022294b27c06a24fb1c4e91b",
    "src/openpi/models/pi0.py": "c6a3cc0583ff30fcb16ac28ef0cecef28277e4a2b34fc51cf5190600e437a534",
    "src/openpi/training/config.py": "066721b1bbc3798a93311fa9d298d4fdc87ff00023b4d768fead0da5565b62c8",
    "src/openpi/training/data_loader.py": "543a59d12459841bd2d857586f6edea63037a9fc739601624d7f5e52f034852a",
    "src/openpi/policies/piper_eef_xyz3d_policy.py": "58add88763b407c09e0a9f6998fff4fb31e9955c2a211f9a718bce1f01afc99e"
  },
  "training_pythonpath": "${TRAINER}/src",
  "base_config": "pi05_piper_dual_eef_xyz3d",
  "base_checkpoint_params": "${OPENPI_CACHE}/openpi-assets/checkpoints/pi05_base/params",
  "paligemma_tokenizer": "${OPENPI_CACHE}/big_vision/paligemma_tokenizer.model",
  "paligemma_tokenizer_sha256": "8986bb4f423f07f8c7f70d0dbe3526fb2316056c17bae71b1ea975e77a168fc6",
  "lerobot_home": "${DATASETS}",
  "repo_id": "<org>/<dataset>",
  "minimum_episodes": 1,
  "dataset_fps": 30,
  "allowed_semantic_waivers": [],
  "assets_base_dir": "${TRAINING_RUN}/assets",
  "checkpoint_base_dir": "${TRAINING_RUN}/checkpoints",
  "run_manifest_dir": "${WORKSPACE}/runs/<task>/training",
  "metrics_jsonl": "${WORKSPACE}/runs/<task>/training/training-metrics.jsonl",
  "observability_protocol": "training-observability-v1",
  "eval_interval": 1000,
  "project_name": "datafarm-pi05",
  "exp_name": "pi05-<task>-v1",
  "seed": 42,
  "batch_size": 128,
  "num_workers": 4,
  "num_train_steps": 50000,
  "log_interval": 100,
  "save_interval": 1000,
  "keep_period": 10000,
  "fsdp_devices": 8,
  "gpu_candidates": [
    8,
    4
  ],
  "gpu_authorization_id": "<authorization-id>",
  "wandb_enabled": false,
  "gpu_scheduler": "${GPU_SCHEDULER}",
  "state_conditioning": "none",
  "action_representation": "absolute_eef",
  "production_policy_eligible": false,
  "local_robustness_authorization_id": "<authorization-id>"
}
