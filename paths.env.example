# Copy to paths.env (git-ignored) and fill in the paths of your machine; tools/env.sh reads it.
# Only paths and model names here: API keys are exported in your shell, never written to a file
# of the repository (see docs/MODELS.md).

# --- RoboDojo (main benchmark; see docs/SETUP.md) -------------------------------------------
# RoboDojo checkout at commit cb2a37d58dbb with the submodules it records (XPolicyLab 53c5da5a01bc,
# cuRobo d17b54ce32cb) and the Assets of the HF dataset RoboDojo-Benchmark/RoboDojo at revision
# 35efbc7dedfdbeeb6e95fb749bd885d73d483e41 (docs/SETUP.md).
ROBODOJO_SOURCE_ROOT=/path/to/RoboDojo
# Python of RoboDojo's simulator environment (Isaac Sim 5.1.0, Isaac Lab 0.54.3).
ROBODOJO_SIM_PYTHON=/path/to/envs/robodojo/bin/python
# The instruction-faithful criteria built by faithful_criteria/build_source.sh (default tag v2-b9).
ROBODOJO_FAITHFUL_ROOT=/path/to/CriteriaExposure/faithful_criteria/build/v2-b9

# --- This repository's Python ---------------------------------------------------------------
# The environment with this package's dependencies and SAM3 (docs/SETUP.md); the LIBERO and
# RoboCasa evaluations start their episodes with it.
CE_PYTHON=/path/to/envs/criteria-exposure/bin/python

# --- Perception -----------------------------------------------------------------------------
SAM3_CHECKPOINT_PATH=/path/to/checkpoints/sam3.pt

# --- LIBERO-PRO (optional) ------------------------------------------------------------------
# RPent checkout (robots/libero, rpent/) and the Python of its LIBERO-PRO environment.
RPENT_ROOT=/path/to/RPent
LIBERO_PYTHON=/path/to/RPent/.venv/bin/python
LIBERO_PRO_ASSET_PATH=/path/to/liberopro-assets
# The liberopro/liberopro directory of the LIBERO-PRO package (bddl_files/, init_files/).
LIBERO_PRO_ROOT=/path/to/RPent/.venv/lib/python3.11/site-packages/liberopro/liberopro

# --- RoboCasa365 (optional) -----------------------------------------------------------------
# Python with robocasa + robosuite (it runs the kitchen), its site-packages and the assets.
ROBOCASA_SIM_PYTHON=/path/to/envs/robocasa/bin/python
ROBOCASA_SIM_PACKAGES=/path/to/envs/robocasa/lib/python3.10/site-packages
ROBOCASA_ASSETS_PATH=/path/to/robocasa-assets

# --- Models (names only; the paper's settings) ----------------------------------------------
# The actor: an OpenAI-compatible Chat Completions endpoint (execution.runtime openai).
ACTOR_MODEL=gpt-6-astra
ACTOR_BASE_URL=https://api.openai.com/v1
# The learner: Claude Code (the `claude` CLI), model alias or id.
LEARNER_MODEL=claude-opus-5-5
