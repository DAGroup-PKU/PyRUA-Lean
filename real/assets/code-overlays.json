  "tic-tac-toe": {
    "file": "duo_selfplay.py",
    "label": "Stage-linked code",
    "lines": [
      "self.board,pieces=self.stable_scene([0]*9)",
      "while outcome(tuple(self.board)) is None:",
      "    _,cell=solve(tuple(self.board),turn)",
      "    destination=self.config['cells'][cell]['xy_board']",
      "    stock=[p for p in pieces if p['symbol']==turn and cell_of(p['xy']) is None]",
      "    if not stock:raise RuntimeError('No stock piece for current player')",
      "    source=min(stock,key=lambda p:np.linalg.norm(np.array(p['xy'])-destination))",
      "    self.log('decision',symbol=turn,cell=cell+1,board=self.board)",
      "    pieces=self.transfer(source,destination);turn=3-turn",
      "# …",
      "session=PieceTransferSession(self.output/'workcell.json',TASK/f'config/tool_{side}.json',side,",
      "    Path(action['path']),controller=self.ctrl,sensors=self.hub,smooth=True,symbol=symbol)",
      "try:",
      "    held=session.pick(np.array(source))",
      "    self.checkpoint(pending=action,held=held)",
      "    result=session.place(held,np.array(destination))",
      "    self.log('transfer_released',**action,result=result)",
      "# …",
      "    self.board,pieces=self.stable_scene(expected,destination,symbol)",
      "    self.checkpoint();self.log('transfer_verified',**action)",
      "    return pieces",
      "",
      "def reset(self):",
      "    self.phase='RESET';self.board,pieces=self.stable_scene()",
      "    while True:",
      "        action=reset_action(pieces)",
      "        if action is None:break",
      "        pieces=self.transfer(*action)",
      "    self.board,pieces=self.stable_scene([0]*9)",
      "    self.log('reset_completed',board=self.board)"
    ],
