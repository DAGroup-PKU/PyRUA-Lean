  "towel-folding": {
    "file": "far_fold.py",
    "label": "Source excerpt",
    "lines": [
      "obs = observe_towel(session, t0)",
      "# …",
      "ft = fold_targets(session, obs)",
      "# …",
      "for s in sides:",
      "    session.set_dynamics(s, FAST); session.arms[s].move_joints(paths[s][0], asynchronous=True)   # both fly now",
      "plan = fold_plan(session, pinch_pred, 'in', poses={s: {'q': pinch_pred[s]['actual_q'], 'T': pinch_pred[s]['actual_T']} for s in sides})",
      "# …",
      "print(f'measured [{time.monotonic()-t0:.1f}s]', flush=True)",
      "if fix:",
      "    move_both(session, fix, FAST, 'wrist_fix', smooth=True, quick=True)",
      "move_both(session, down, .04, 'descend_both', probe=True, rise_n=4., hard_n=12., smooth=True, quick=True)   # gentle: stop before the reflex",
      "# …",
      "states = close_both(session, list(sides)); print('closed', {s: (st.position, st.obj_status) for s, st in states.items()}, f'[{time.monotonic()-t0:.1f}s]', flush=True)",
      "write_grasp_reports(session, list(sides), states, insets, planes)",
      "for s in sides:",
      "    plan['arms'][s]['held_position'] = states[s].position",
      "# …",
      "for i, f in enumerate((.25, .5, .75, 1.0)):",
      "    move_both(session, {s: [{'q': targets[s][i], 'min_time_s': 2.0}] for s in sides}, .3, f'arc_{int(f*100)}', quick=True)",
      "print(f'arc done [{time.monotonic()-t0:.1f}s]', flush=True)"
    ],
