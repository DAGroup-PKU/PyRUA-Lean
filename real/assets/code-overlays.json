  "tower-of-hanoi": {
    "file": "grasp_any_disk.py",
    "lines": [
      "log(\"stack_round\", round=round_, on_table=[(d[\"id\"], d[\"colour\"], round(d[\"D_snap_m\"] * 1000, 1)) for d in todo], stacked=stack_count)",
      "# …",
      "try:",
      "    g = ep.run()",
      "# …",
      "ins = Inserter(ep, pegs[side], log, stack_count).run()",
      "ins[\"grasp\"] = {k: g.get(k) for k in (\"chord_mm\", \"close_preload_N\", \"centring_residual_mm\")}",
      "log(\"INSERT_RESULT\", **{k: v for k, v in ins.items() if k != \"attempts\"}, n_attempts=len(ins.get(\"attempts\", [])))",
      "results.append(ins)",
      "held_stop = False",
      "if ins[\"verdict\"] == \"SEATED\":",
      "    stack_count += 1",
      "    stacked_ds.append((target[\"D_snap_m\"], target[\"colour\"]))",
      "# …",
      "log(\"unstack_target\", k=k, colour=colour, D_mm=round(D * 1000, 1), seat_h=round(seat_h, 3), arm=None if not chosen else chosen[0])",
      "# …",
      "ok, grec = picker.grasp_from_peg(D, opening, seat_h, colour=colour, below=below)",
      "# …",
      "okp, placed = picker.place_on_table(centre, plan, opening, level_normal=grec.get(\"disk_normal_flange\"))",
      "if okp:",
      "    cL = to_left_base(placed) if side == \"right\" else np.asarray(placed)",
      "# …",
      "results[-1][\"verify\"] = verify_placed_on_table(log, side, colour, D, placed, tag=f\"verify_{len(results)}_{colour}\", arms=arms, wrists=wrists)"
