  "block-storage": {
    "file": "task.py",
    "label": "Stage-linked code",
    "lines": [
      "self.log(f\"   [{side}] refined by wrist: {mobj}\")",
      "# …",
      "held, _ = u.grip.grasp()",
      "R_e, t_e = u.arm.pose()",
      "lift = u.on_table(u.tcp()) + n * g.lift_height",
      "u.arm.move_linear(R_e, u.ee_from_tcp(R_e, lift), m.dyn_fine)",
      "if held:",
      "    time.sleep(0.2); held = u.grip.holding()",
      "if not held:",
      "    self.log(f\"   [{side}] nothing in the gripper\"); u.grip.open(); return False",
      "u.pending_bowl_c, u.pending_rim_h, u.pending_bowl_r = bowl_c, rim_h, bowl.radius",
      "if do_place:",
      "    with self.container_lock:",
      "        self.place(u, bowl_c, rim_h, bowl.radius)",
      "return True",
      "# …",
      "if obj.shared:                       # near the container: hold the lock for pick and place",
      "    with self.container_lock:",
      "        ok = self.pick_and_place(u, obj, bowl, others, do_place=False, attempt=n_try)",
      "        if ok is True:",
      "            self.place(u, u.pending_bowl_c, u.pending_rim_h, u.pending_bowl_r)",
      "else:",
      "    ok = self.pick_and_place(u, obj, bowl, others, attempt=n_try)",
      "# …",
      "results.append((side, obj, ok))",
      "if ok:",
      "    self.log(f\"   [{side}] placed {obj.colour}\")"
