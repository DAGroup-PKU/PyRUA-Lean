    "lines": [
      "self.set_held(None)                                   # jaws empty: forget any stale held-state",
      "t_a = time.monotonic(); wb, img = self.wrist_blocks(); t_b = time.monotonic(); S.cv2.imwrite(str(self.res_dir/f'scan-{k}.png'), img)",
      "cands = self.choose_target(wb, box['footprint_centre'])",
      "cands = [t for t in cands if not self.target_failed(t[2]['centre'])]",
      "checked = []; t_c = time.monotonic()",
      "for c_, d, b, i in cands:",
      "    checked.append((c_, d, b, i, self.reachable(b, box=box)))",
      "    if checked[-1][4][0]:",
      "        break",
      "# …",
      "rec.update(self.pick(target, box))",
      "if rec['outcome'] == 'grasped':",
      "    rec['placed'] = self.place(box, self.yaw_now(), target.get('_drop_centre'), from_grasp=rec['grasp_pose'], drop_yaw=target.get('_drop_yaw'))",
      "    rec['outcome'] = 'placed' if rec['placed'] else 'lost_in_transport'"
    ],
