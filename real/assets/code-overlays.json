  "five-block-stacking": {
    "file": "stack_cycles.py",
    "label": "Stage-linked code",
    "lines": [
      "def perform_cycle(cell, objects, slots, cycle):",
      "    layers = {'yellow': objects['yellow']}",
      "    top = layers['yellow']",
      "    for colour in ORDER[1:]:",
      "        top = cell.relocate(SIDES[colour], objects[colour], top, THICKNESS[colour], f'c{cycle}_up_{colour}')",
      "        layers[colour] = top",
      "        save(cell.out / 'checkpoint.json', dict(cycle=cycle, phase='stack', layers=layers, scene=cell.scene))",
      "    staged = {'yellow': layers['yellow']}",
      "    for i in range(4, 0, -1):",
      "        colour = ORDER[i]",
      "        below = layers[ORDER[i - 1]]",
      "        staged[colour] = cell.relocate(SIDES[colour], layers[colour], slots[colour], THICKNESS[colour],",
      "                                      f'c{cycle}_down_{colour}', underneath=below, table=True)",
      "        save(cell.out / 'checkpoint.json', dict(cycle=cycle, phase='unstack', staged=staged, scene=cell.scene))",
      "    return staged"
    ],
