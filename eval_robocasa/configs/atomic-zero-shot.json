{
 "label": "RoboCasa365 Target50 atomic, zero-shot: the PyRUA-Lean paper's cells (18 tasks x seeds 1-5; CoffeeSetupMug 1, 2, 3, 5, 6), no library; robocasa_rgb no-vla, no success signal shown to the model (no done / task_progress / criteria), images on demand, pure feedback, 40 cells / 7200 s, native-action budget = RoboCasa's official task horizon",
 "task_names": [
  "CloseBlenderLid",
  "CloseFridge",
  "CloseToasterOvenDoor",
  "CoffeeSetupMug",
  "NavigateKitchen",
  "OpenCabinet",
  "OpenDrawer",
  "OpenStandMixerHead",
  "PickPlaceCounterToCabinet",
  "PickPlaceCounterToStove",
  "PickPlaceDrawerToCounter",
  "PickPlaceSinkToCounter",
  "PickPlaceToasterToCounter",
  "SlideDishwasherRack",
  "TurnOffStove",
  "TurnOnElectricKettle",
  "TurnOnMicrowave",
  "TurnOnSinkFaucet"
 ],
 "seeds": [
  1,
  2,
  3,
  4,
  5
 ],
 "seed_overrides": {
  "CoffeeSetupMug": [
   1,
   2,
   3,
   5,
   6
  ]
 },
 "concurrency": 4,
 "gpus": [
  0
 ],
 "per_gpu": 4,
 "need_gib": 20,
 "stagger_seconds": 20,
 "pause_after_provider_failures": 3,
 "environment": {
  "NO_PROXY": "localhost,127.0.0.1,::1",
  "no_proxy": "localhost,127.0.0.1,::1"
 },
 "paths": {
  "python": "${CE_PYTHON}",
  "lean": "${CE_ROOT}",
  "sim_python": "${ROBOCASA_SIM_PYTHON}",
  "sim_packages": "${ROBOCASA_SIM_PACKAGES}",
  "assets": "${ROBOCASA_ASSETS_PATH}",
  "sam3_checkpoint": "${SAM3_CHECKPOINT_PATH}"
 },
 "sam3_sha256": "${SAM3_SHA256:-9999e2341ceef5e136daa386eecb55cb414446a00ac2b55eb2dfd2f7c3cf8c9e}",
 "execution": {
  "robot": "robocasa_rgb",
  "primitives": "no-vla",
  "split": "target",
  "runtime": "openai",
  "model": "${ACTOR_MODEL:-gpt-6-astra}",
  "base_url": "${ACTOR_BASE_URL}",
  "api_key_env": "ACTOR_API_KEY",
  "extra_body": {
   "reasoning_effort": "high"
  },
  "images": "on-demand",
  "feedback": "pure",
  "max_cells": 40,
  "max_model_requests": 80,
  "max_tokens": 8192,
  "nudges": 20,
  "provider_retries": 2,
  "policy_seconds": 7200,
  "max_episode_steps": 10000
 },
 "budgets": {
  "max_launches": 180,
  "max_hours": 48,
  "max_infra_retries": 2,
  "episode_watchdog_seconds": 8400
 }
}
