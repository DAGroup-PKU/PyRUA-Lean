    "RI": 8,
    "R3": 10,
    "P4": 8,
    "R3b": 6,
    "R1u": 10,
    "P2u": 30
  },
  "poll_seconds": 30,
  "freshness_forbidden": [],
  "environment": [
    "Simulator python: <path>. Project tools python: <path>.",
    "Run simulator jobs with: <your scheduler or wrapper command>. Run up to <N> seeds at once per GPU.",
    "Robot hardware assets (URDF and meshes, read-only): <path>."
