diff --git a/tools/prepare_hed_control.py b/tools/prepare_hed_control.py
new file mode 100644
index 0000000..abe4af1
--- /dev/null
+++ b/tools/prepare_hed_control.py
@@ -0,0 +1,104 @@
+#!/usr/bin/env python3
+"""Generate a soft-HED control video for the low-contrast simulator render."""
+
+import argparse
+import json
+import os
+import sys
+from pathlib import Path
+
+import cv2
+import numpy as np
+import torch
+
+
+# directory that contains tools/controlnet/annotator/{hed,util.py} (ControlNet v1.1 annotator, Apache-2.0)
+if not os.environ.get("H3_HED_ANNOTATOR_REPO"):
+    raise SystemExit("set H3_HED_ANNOTATOR_REPO to the directory containing tools/controlnet/annotator/hed")
+ANNOTATOR_REPO = Path(os.environ["H3_HED_ANNOTATOR_REPO"])
+sys.path.insert(0, str(ANNOTATOR_REPO))
+from tools.controlnet.annotator.hed import ControlNetHED_Apache2  # noqa: E402
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--input", required=True)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--checkpoint", required=True)
+    parser.add_argument("--width", type=int, default=1024)
+    parser.add_argument("--height", type=int, default=768)
+    parser.add_argument("--max-frames", type=int, default=90)
+    parser.add_argument(
+        "--min-edge-intensity",
+        type=int,
+        default=0,
+        help="zero HED intensities below this value; 0 preserves the historical soft map",
+    )
+    args = parser.parse_args()
+
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    model = ControlNetHED_Apache2().float().to(device).eval()
+    state = torch.load(args.checkpoint, map_location="cpu", weights_only=True)
+    model.load_state_dict(state)
+
+    capture = cv2.VideoCapture(args.input)
+    if not capture.isOpened():
+        raise RuntimeError(f"could not open input: {args.input}")
+    fps = capture.get(cv2.CAP_PROP_FPS)
+    output = Path(args.output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    writer = cv2.VideoWriter(
+        str(output), cv2.VideoWriter_fourcc(*"mp4v"), fps, (args.width, args.height)
+    )
+    if not writer.isOpened():
+        raise RuntimeError(f"could not open writer: {output}")
+
+    frames = 0
+    active_sum = 0.0
+    mean_sum = 0.0
+    with torch.inference_mode():
+        while frames < args.max_frames:
+            ok, frame = capture.read()
+            if not ok:
+                break
+            frame = cv2.resize(frame, (args.width, args.height), interpolation=cv2.INTER_AREA)
+            rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
+            tensor = torch.from_numpy(rgb.copy()).float().permute(2, 0, 1).unsqueeze(0).to(device)
+            projections = model(tensor)
+            maps = []
+            for projection in projections:
+                item = projection[0, 0].float().cpu().numpy()
+                maps.append(cv2.resize(item, (args.width, args.height), interpolation=cv2.INTER_LINEAR))
+            logits = np.mean(np.stack(maps, axis=2), axis=2).astype(np.float64)
+            edge = 1.0 / (1.0 + np.exp(-logits))
+            edge = (edge * 255.0).clip(0, 255).astype(np.uint8)
+            if args.min_edge_intensity:
+                edge[edge < args.min_edge_intensity] = 0
+            writer.write(cv2.cvtColor(edge, cv2.COLOR_GRAY2BGR))
+            active_sum += float(np.mean(edge > 20))
+            mean_sum += float(np.mean(edge) / 255.0)
+            frames += 1
+
+    capture.release()
+    writer.release()
+    metadata = {
+        "schema_version": "hed_control/1.0.0",
+        "input": str(Path(args.input).resolve()),
+        "output": str(output.resolve()),
+        "checkpoint": str(Path(args.checkpoint).resolve()),
+        "device": str(device),
+        "fps": fps,
+        "width": args.width,
+        "height": args.height,
+        "frames": frames,
+        "mean_active_fraction_gt20": active_sum / frames,
+        "mean_normalized_intensity": mean_sum / frames,
+        "min_edge_intensity": args.min_edge_intensity,
+    }
+    metadata_path = output.with_suffix(".json")
+    metadata_path.write_text(json.dumps(metadata, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(metadata, indent=2))
+
+
+if __name__ == "__main__":
+    main()
